# Copy to `.env` next to docker-compose.yml and fill in. Docker Compose reads it automatically.

# --- Which AI writes the summaries: "anthropic" (Claude API) or "ollama" (self-hosted) ---
READCUE_LLM_PROVIDER=anthropic

# Claude API. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Ollama (self-hosted alternative): set READCUE_LLM_PROVIDER=ollama and pick ONE host:
#   bundled container (docker compose --profile ollama up -d):  http://ollama:11434
#   Ollama running on this machine outside Docker:              http://host.docker.internal:11434
#   another machine on your network:                            http://192.168.1.50:11434
# OLLAMA_HOST=http://ollama:11434
# OLLAMA_MODEL=llama3.1:8b
# Context window in tokens. Chapters longer than about half of this are summarized in parts.
# OLLAMA_NUM_CTX=16384
# COMPOSE_PROFILES=ollama   # start the bundled Ollama container automatically

# --- Pushover (https://pushover.net): create an application for the token; your user key is on the dashboard ---
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# --- When things happen ---
# A chapter is only summarized once it's due within this many days. Chapters you upload earlier wait,
# so nothing is spent on a reading whose date might still change. "Summarize now" overrides it.
READCUE_SUMMARIZE_DAYS_BEFORE=3
# Reminder goes out this many days before a chapter is due (1 = the day before), from this local time.
# Keep it at or below the summarize window so the summary is ready when the reminder arrives.
READCUE_NOTIFY_DAYS_BEFORE=1
READCUE_NOTIFY_TIME=08:00
TZ=America/New_York

# --- OCR (scanned PDFs and photos of pages) ---
# Tesseract language code(s), e.g. eng, spa, eng+spa. The published image has English only; other
# languages need a source build: EXTRA_OCR_PACKAGES="tesseract-ocr-spa" with docker-compose.build.yml.
READCUE_OCR_LANG=eng
# EXTRA_OCR_PACKAGES=

# --- Image version ---
# latest by default; pin a release for repeatable installs (see the Releases page).
# READCUE_VERSION=1.0.0

# --- Where the data lives (NAS users: read this) ---
# Default is a Docker-managed volume. To keep it in a folder you can browse and back up, set an absolute
# path, and make the container run as that folder's owner (on Synology, `id <user>` shows the numbers).
# READCUE_DATA=/volume1/docker/readcue/data
# READCUE_UID=1026
# READCUE_GID=100

# --- Web UI ---
# Public address of this app; adds an "Open summary" link to each notification.
# READCUE_BASE_URL=http://my-server.local:8080
# READCUE_PORT=8080
# Listen only on this machine by default. Use 0.0.0.0 to allow other devices, and set a password:
# the app refuses to start when it's reachable beyond localhost without one.
# READCUE_BIND=0.0.0.0
# READCUE_USERNAME=readcue
# READCUE_PASSWORD=
# READCUE_LOG_LEVEL=INFO
